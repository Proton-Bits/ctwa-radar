# ─────────────────────────────────────────────────────────────
#  CTWA Radar — copie para .env e preencha.
#  Nada aqui vai para o repositorio: .env esta no .gitignore.
# ─────────────────────────────────────────────────────────────

# App
PORT=3000
DB_PATH=./data/radar.db
TZ=America/Sao_Paulo

# Token do painel e da API REST (usado pelo painel maior depois).
# Gere com: openssl rand -hex 24
DASHBOARD_TOKEN=

# ── Evolution API ────────────────────────────────────────────
EVOLUTION_URL=https://sua-evolution.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Opcional: se preenchido, o webhook so aceita requisicoes que
# tragam este valor no header x-radar-token.
EVOLUTION_WEBHOOK_TOKEN=

# ── Meta / API de Conversoes ─────────────────────────────────
META_DATASET_ID=
META_ACCESS_TOKEN=
META_WABA_ID=
META_GRAPH_VERSION=v25.0

# Codigo da aba "Testar eventos" do Gerenciador de Eventos.
# Deixe preenchido enquanto valida; apague ao ir para producao.
META_TEST_EVENT_CODE=

# Evento disparado quando o lead entra no grupo.
META_EVENT_NAME=Lead

# Trave de seguranca: com false o radar so COLETA e mostra no painel,
# sem postar nada na Meta. Vire para true depois de validar os dados.
CAPI_ENABLED=false

# ── Regras de negocio ────────────────────────────────────────
# JIDs dos grupos monitorados, separados por virgula.
# Vazio = considera entrada em qualquer grupo.
GRUPOS_MONITORADOS=

# Minutos que o lead tem para entrar no grupo depois do clique.
# Passou disso sem entrada, vira "perdido".
JANELA_ENTRADA_MIN=30

# Casamento por proximidade de horario, para quem entra no grupo
# sem nunca ter mandado mensagem para o numero.
MATCH_POR_TEMPO=true
JANELA_MATCH_TEMPO_MIN=10

# ── Alerta de queda ──────────────────────────────────────────
# A cada 15 min o radar compara a taxa de entrada da ultima hora
# com a media das 24h anteriores e avisa se despencou.

# Numero que recebe o aviso no WhatsApp, so digitos com DDI
# (ex: 5514991112222). Vazio = o alerta e registrado mas nao enviado.
ALERTA_WHATSAPP=

# Queda relativa da taxa de entrada que dispara o aviso, em %.
ALERTA_QUEDA_PCT=30

# Amostra minima da ultima hora, para nao alarmar com 2 cliques.
ALERTA_MIN_CLIQUES=10

# Silencio minimo entre dois avisos, em minutos.
ALERTA_INTERVALO_MIN=60
